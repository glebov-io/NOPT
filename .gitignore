# Build artifacts (universal — anyone building NOPT generates these)
*.o
*.d
*.gcda
*.gcno
/run_sQM
# every program the Makefile links (run_%)
/run_*
/run_hessian
/run_optimization
/include/git_stamp.h

# Per-machine build config: paths differ on every machine, so it is not tracked.
# Copy the template and edit it:  cp Makefile_example.vars Makefile.vars
/Makefile.vars

# records which libint the objects were built with (tests/gradients/build.sh)
/.libint_mode
